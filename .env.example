# Скопировать в .env на сервере и заполнить. .env в git не попадает.

HUB_NAME=SrannyHub
# Linkvertise: число из ссылок link-to.net/<ID>/...
LV_USER_ID=
# Токен Anti-Bypassing из кабинета Linkvertise
LV_ANTI_BYPASS=

# Lootlabs: API-токен из кабинета (Dashboard -> Settings/Developers -> API token).
# Пока пусто — кнопка Lootlabs на сайте не показывается.
LOOTLABS_API_TOKEN=
# tier_id и число заданий из кабинета Lootlabs
LOOTLABS_TIER_ID=1
LOOTLABS_TASKS=1
# 1 = проверять прохождение через anti-bypassing API Lootlabs
LOOTLABS_ANTI_BYPASS=1
# Пароль API для curl (длинная случайная строка)
ADMIN_TOKEN=

# Срок бесплатного ключа (часы) и минимум секунд на прохождение Linkvertise
KEY_HOURS=24
MIN_SECONDS=10
COMMUNITY_URL=

# Сервер слушает только localhost, наружу — Caddy
HOST=127.0.0.1
PORT=8787
DATA_DIR=data
SCRIPT_FILE=script/SrannyHub.lua

# На сервере НЕ включать: выдаёт ключ без Linkvertise (только для localhost)
DEV_NO_LINKVERTISE=0

# Админ-панель: http://<IP>:<ADMIN_PORT>/<ADMIN_PATH>/login
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PATH=d8xuj1idaso/panel/8318
# пусто = случайный порт (сохраняется в data/admin.json)
ADMIN_PORT=
ADMIN_HOST=127.0.0.1

# Адрес сайта, который вшивается в loader (на VPS setup.sh ставит https://<домен>)
PUBLIC_URL=
